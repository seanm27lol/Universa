      "novelty_tol": 1e-06,
      "null_control_call": "universa.loop.run_loop(LOOP, instance, instance.decoy_targets, seed=seed, observations=universa.loop.null_observations(seed, ambient_dim, 16))",
      "num_observations": 16,
      "out_of_library_call": "universa.loop.run_loop(LOOP, instance, instance.decoy_targets, seed=seed)"
